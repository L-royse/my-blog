---
/**
 * 关于页
 * 个人介绍 + 联系方式
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchUser } from '@/data/github';

const user = await fetchUser();
const avatarUrl = user?.avatar_url || 'https://avatars.githubusercontent.com/u/91481629?v=4';
---

<BaseLayout title="About — 关于我">
  <div class="max-w-2xl mx-auto">
    <!-- 标题 -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3 gradient-text">/about</h1>
      <p class="text-text-secondary font-mono text-sm">// whoami — get to know me</p>
    </div>

    <!-- 头像 + 简介 -->
    <div class="glass-card p-8 mb-8">
      <div class="flex items-center gap-6 mb-6">
        <img
          src={avatarUrl}
          alt="avatar"
          class="w-20 h-20 rounded-full border-2"
          style="border-color: var(--color-border-glow);"
        />
        <div>
          <h2 class="text-2xl font-bold mb-1">
            {user?.name || 'L-royse'}
          </h2>
          <p class="font-mono text-sm text-accent-cyan m-0">@L-royse</p>
        </div>
      </div>

      <div class="space-y-4 text-text-secondary leading-relaxed">
        <p>
          👋 你好！我是 <span class="text-text-primary font-semibold">L-royse</span>，
          一个热爱编程的开发者。
        </p>
        <p>
          我喜欢把想法变成代码，把代码变成产品。日常在前端/全栈之间穿梭，
          对构建工具、设计系统和开发者体验特别感兴趣。
        </p>
        <p>
          这个网站是我的数字花园 🌱 —— 记录学习笔记、开源项目，还有偶尔的随笔。
          代码开源，想法开放，欢迎交流！
        </p>
      </div>
    </div>

    <!-- 联系方式 -->
    <div class="glass-card p-6 mb-8">
      <h3 class="section-title">contact</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="https://github.com/L-royse" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-lg no-underline transition-colors hover:bg-bg-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-text-secondary)"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.54-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.75c1.03.01 2.07.14 3.03.4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.22.69.83.58C20.57 21.8 24 17.31 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <div>
            <div class="font-mono text-xs text-text-muted">GitHub</div>
            <div class="text-text-primary">@L-royse</div>
          </div>
        </a>
        <a href="mailto:hello@example.com" class="flex items-center gap-3 p-3 rounded-lg no-underline transition-colors hover:bg-bg-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-text-secondary)"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          <div>
            <div class="font-mono text-xs text-text-muted">Email</div>
            <div class="text-text-primary">hello@example.com</div>
          </div>
        </a>
      </div>

      <p class="font-mono text-xs text-text-muted mt-4">
        💡 提示：编辑 <code>src/pages/about.astro</code> 修改联系方式
      </p>
    </div>

    <!-- 本站信息 -->
    <div class="glass-card p-6">
      <h3 class="section-title">colophon</h3>
      <div class="font-mono text-xs text-text-secondary space-y-2">
        <p><span class="text-accent-cyan">site</span>    : built with Astro 5 + Tailwind CSS v4</p>
        <p><span class="text-accent-cyan">deployed</span>: on GitHub Pages</p>
        <p><span class="text-accent-cyan">data</span>    : live from GitHub REST API</p>
        <p><span class="text-accent-cyan">license</span> : MIT (for code), CC-BY (for content)</p>
      </div>
    </div>
  </div>
</BaseLayout>
