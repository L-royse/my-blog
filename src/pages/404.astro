---
/**
 * 404 页面 —— Nginx error_page 指向 /404.html
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 页面不存在" description="这个页面不存在">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
    <p class="font-mono text-xs text-text-muted mb-4">
      <span class="text-accent-cyan">$</span> curl -I /this-page
    </p>

    <h1 class="text-7xl sm:text-9xl font-bold gradient-text mb-4 font-mono">404</h1>

    <p class="text-text-secondary mb-8 font-mono text-sm">
      // 这条路径通向虚无，或者页面被移动了
    </p>

    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn-neon">← Back Home</a>
      <a href="/blog" class="btn-neon" style="border-color: var(--color-accent-purple); color: var(--color-accent-purple);">Read Blog</a>
    </div>
  </div>
</BaseLayout>
