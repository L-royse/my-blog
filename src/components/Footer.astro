---
/**
 * 页脚
 */
const year = new Date().getFullYear();
---

<footer
  class="mt-24 py-10 border-t border-border"
  style="position: relative; z-index: 1;"
>
  <div class="mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-mono text-xs text-text-muted m-0">
      <span class="text-accent-cyan">const</span> <span class="text-accent-purple">site</span> = <span class="text-text-secondary">"built with Astro + Tailwind"</span>;
    </p>

    <div class="flex items-center gap-4 font-mono text-xs">
      <a href="https://github.com/L-royse" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent-cyan no-underline">github</a>
      <span class="text-border">|</span>
      <a href="/rss.xml" class="text-text-muted hover:text-accent-cyan no-underline">rss</a>
      <span class="text-border">|</span>
      <span class="text-text-muted">© {year}</span>
    </div>
  </div>
</footer>
