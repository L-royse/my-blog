---
/**
 * 博客文章卡片（首页和列表页复用）
 */
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const minutes = Math.max(1, Math.round(readingTime(post.body).minutes));
const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/blog/${post.slug}/`}
  class="glass-card block p-5 no-underline group"
>
  <div class="flex items-center gap-3 mb-3 font-mono text-xs text-text-muted">
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    <span>·</span>
    <span>{minutes} min read</span>
  </div>

  <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent-cyan transition-colors m-0 leading-snug">
    {post.data.title}
  </h3>

  <p class="text-sm text-text-secondary mb-4 line-clamp-2 m-0">
    {post.data.description}
  </p>

  {post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {post.data.tags.slice(0, 3).map((tag) => (
        <span class="tag">#{tag}</span>
      ))}
    </div>
  )}
</a>
