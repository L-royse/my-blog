---
/**
 * Hero 区域 —— 首页顶部
 * 展示头像、名字、一句话定位
 */
import type { GithubUser } from '@/data/github';

interface Props {
  user: GithubUser | null;
}

const { user } = Astro.props;

const name = user?.name || 'L-royse';
const avatarUrl = user?.avatar_url || 'https://avatars.githubusercontent.com/u/91481629?v=4';
---

<section class="mb-20">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8 mb-10">
    <!-- Avatar -->
    <div class="relative">
      <div
        class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2"
        style="border-color: var(--color-border-glow); box-shadow: 0 0 32px rgba(34, 211, 238, 0.2);"
      >
        <img
          src={avatarUrl}
          alt={name}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <span
        class="absolute bottom-1 right-1 w-4 h-4 rounded-full border-2"
        style="background: #22c55e; border-color: var(--color-bg-primary);"
        title="open to work"
      ></span>
    </div>

    <!-- Intro -->
    <div class="flex-1">
      <p class="font-mono text-xs text-text-muted mb-2">
        <span class="text-accent-cyan">$</span> whoami
      </p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-4 leading-tight">
        <span class="gradient-text">hi, I'm {name}.</span>
      </h1>
      <p class="text-text-secondary text-base sm:text-lg max-w-xl leading-relaxed">
        一个喜欢折腾代码的开发者。在这里记录我的学习笔记、项目思考，还有偶尔冒出的奇怪想法。
        <span class="text-accent-cyan">// let's build something interesting.</span>
      </p>
    </div>
  </div>

  <!-- 快速链接 -->
  <div class="flex flex-wrap gap-3">
    <a href="/projects" class="btn-neon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      View Projects
    </a>
    <a href="/blog" class="btn-neon" style="border-color: var(--color-accent-purple); color: var(--color-accent-purple);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      Read Blog
    </a>
    <a href="https://github.com/L-royse" target="_blank" rel="noopener noreferrer" class="btn-neon" style="border-color: var(--color-text-muted); color: var(--color-text-secondary);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.54-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.75c1.03.01 2.07.14 3.03.4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.22.69.83.58C20.57 21.8 24 17.31 24 12c0-6.63-5.37-12-12-12z"/></svg>
      GitHub
    </a>
  </div>
</section>
