---
/**
 * GitHub 项目卡片
 */
import { getLanguageTagClass } from '@/data/github';
import type { GithubRepo } from '@/data/github';

interface Props {
  repo: GithubRepo;
}

const { repo } = Astro.props;

// 计算相对时间
function timeAgo(dateStr: string): string {
  const now = new Date();
  const date = new Date(dateStr);
  const diff = now.getTime() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return 'today';
  if (days < 7) return `${days}d ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
}
---

<a
  href={repo.html_url}
  target="_blank"
  rel="noopener noreferrer"
  class="glass-card block p-5 no-underline group animate-fade-in-up"
>
  <!-- 头部：Repo 名称 + 状态 -->
  <div class="flex items-start justify-between gap-2 mb-3">
    <div class="flex items-center gap-2 min-w-0">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="color: var(--color-accent-cyan); flex-shrink: 0;"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
      <h3 class="font-mono text-base font-semibold text-text-primary truncate group-hover:text-accent-cyan transition-colors m-0">
        {repo.name}
      </h3>
    </div>
    {repo.archived && (
      <span class="tag" style="font-size: 0.625rem;">archived</span>
    )}
  </div>

  <!-- 描述 -->
  <p class="text-sm text-text-secondary mb-4 line-clamp-2 m-0 leading-relaxed min-h-[2.5rem]">
    {repo.description || '// no description yet'}
  </p>

  <!-- 底部：语言 + 统计 + 更新时间 -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-text-muted">
    {repo.language && (
      <span class={`tag ${getLanguageTagClass(repo.language)}`}>
        {repo.language}
      </span>
    )}

    <span class="flex items-center gap-1">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
      {repo.stargazers_count}
    </span>

    <span class="flex items-center gap-1">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
      {repo.forks_count}
    </span>

    <span class="ml-auto text-text-muted">
      updated {timeAgo(repo.updated_at)}
    </span>
  </div>
</a>
